<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="14dp"
    android:layout_marginVertical="5dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface"
    app:strokeWidth="1dp"
    app:strokeColor="@color/card_stroke">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Row 1: Avatar + Name/Time + Subject chip + Star -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Avatar -->
            <TextView android:id="@+id/avatarLetter"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_primary"
                android:gravity="center"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/primary"
                tools:text="R"/>

            <!-- Name + time -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginHorizontal="10dp">
                <TextView android:id="@+id/userName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Riddhi Sardesai"/>
                <TextView android:id="@+id/timeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp"
                    tools:text="5 min ago"/>
            </LinearLayout>

            <!-- Subject pill -->
            <TextView android:id="@+id/subjectChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/primary"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp"
                tools:text="Physics"/>

            <!-- ⭐ Bookmark star — ALWAYS VISIBLE, 36dp, easy to tap -->
            <ImageButton android:id="@+id/bookmarkBtn"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_star_outline"
                android:scaleType="centerInside"
                android:padding="4dp"
                android:contentDescription="Bookmark"/>
        </LinearLayout>

        <!-- Title -->
        <TextView android:id="@+id/doubtTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:lineSpacingExtra="2dp"
            tools:text="How does Newton's second law apply in friction problems?"/>

        <!-- Description -->
        <TextView android:id="@+id/doubtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:lineSpacingExtra="2dp"
            tools:text="I'm confused about static vs kinetic friction in inclined plane problems..."/>

        <!-- Dept + Class tags row -->
        <LinearLayout
            android:id="@+id/tagsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">
            <TextView android:id="@+id/deptTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pending_tag"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:textColor="@color/pending_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp"
                android:visibility="gone"
                tools:text="Science"/>
            <TextView android:id="@+id/classTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_answered_tag"
                android:paddingHorizontal="9dp"
                android:paddingVertical="3dp"
                android:textColor="@color/answered_text"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="12-A"/>
        </LinearLayout>

        <!-- Divider -->
        <View android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="10dp"
            android:background="@color/divider"/>

        <!-- Bottom: status + View button -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView android:id="@+id/repliesCount"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:drawablePadding="4dp"
                tools:text="⏳ 4 views"
                tools:drawableStart="@drawable/ic_attach_file"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/solveBtn"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:paddingHorizontal="18dp"
                android:text="View"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="10dp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
